#!/bin/bash
# Builds roman.wasm beside extension.json. Needs Rust's wasm32-wasip2 target
# (rustup target add wasm32-wasip2, or Arch's rust-wasm package).
set -euo pipefail
cd -- "$(dirname -- "$0")"
cargo build --release --target wasm32-wasip2
cp target/wasm32-wasip2/release/punctum_roman.wasm roman.wasm
sha256sum roman.wasm
