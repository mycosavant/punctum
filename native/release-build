#!/bin/bash
# Builds punctumd's release binaries exactly as .github/workflows/release.yml
# does, so anyone can rebuild one from a tag and compare its SHA-256 with
# native/checksums.txt (and with the release's own .sha256 files).
#
# Usage: native/release-build [out-dir]      default: dist/
#
# Static (musl), so one binary runs on any Linux distribution. The toolchain
# is pinned and the build's own paths are remapped, so where you build it
# doesn't change the bytes.

set -euo pipefail

TOOLCHAIN=1.99.0
TARGETS=(x86_64-unknown-linux-musl)

root=$(cd "$(dirname "$0")/.." && pwd -P)
out=$(mkdir -p "${1:-$root/dist}" && cd "${1:-$root/dist}" && pwd -P)
version=$(sed -n 's/^ *"version": *"\([0-9][0-9.]*\)".*/\1/p' "$root/manifest.json" | head -1)
for crate in punctumd everywhere; do
  have=$(sed -n 's/^version = "\(.*\)"/\1/p' "$root/native/$crate/Cargo.toml" | head -1)
  [[ $version == "$have" ]] || { echo "manifest.json says $version, $crate's Cargo.toml $have" >&2; exit 1; }
done

rustup toolchain install "$TOOLCHAIN" --profile minimal --target "${TARGETS[@]}" >&2
# wasmtime compiles a few small C helpers, so a C compiler for the target is
# needed: the system gcc unless you name another. The bytes depend on it
# too, so the compiler is written beside the binaries (built-with.txt) and
# into the release notes: rebuild with the same one to compare.
export CC_x86_64_unknown_linux_musl=${CC_x86_64_unknown_linux_musl:-gcc}
{ echo "rustc $(rustc "+$TOOLCHAIN" --version | cut -d' ' -f2-)"; "$CC_x86_64_unknown_linux_musl" --version | head -1; } > "$out/built-with.txt"
cat "$out/built-with.txt" >&2
cargo_home=${CARGO_HOME:-$HOME/.cargo}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

for target in "${TARGETS[@]}"; do
  # The build folder too: cranelift's generated code is compiled from it,
  # and a random folder name in the binary would make every build differ.
  RUSTFLAGS="--remap-path-prefix=$root=/punctum --remap-path-prefix=$cargo_home=/cargo --remap-path-prefix=$work=/build -C strip=symbols" \
    CARGO_TARGET_DIR="$work/target" \
    cargo "+$TOOLCHAIN" build --release --locked --target "$target" --manifest-path "$root/Cargo.toml" >&2
  for name in punctumd everywhere; do
    asset="$name-$version-${target/-unknown/}"
    install -m 755 "$work/target/$target/release/$name" "$out/$asset"
    (cd "$out" && sha256sum "$asset" > "$asset.sha256" && cat "$asset.sha256")
  done
done
