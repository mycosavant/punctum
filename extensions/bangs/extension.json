{
  "schema": 1,
  "id": "bangs",
  "name": "Bangs",
  "version": "1.0.0",
  "description": "!nasb john 3:16: send a search straight to one site, DuckDuckGo-style",
  "icon": "󰈸",
  "type": "js",
  "entry": "provider.js",
  "enabled": true,
  "order": 20,
  "helpOrder": 110,
  "mode": {
    "pattern": "^\\s*!",
    "label": "Bang"
  },
  "defaults": {
    "fallback": "https://duckduckgo.com/?q={q}",
    "engines": {
      "ddg": {
        "title": "DuckDuckGo",
        "open": "https://duckduckgo.com/?q={q}",
        "home": "https://duckduckgo.com/"
      },
      "g": {
        "title": "Google",
        "open": "https://www.google.com/search?q={q}"
      },
      "w": {
        "title": "Wikipedia",
        "open": "https://en.wikipedia.org/w/index.php?search={q}"
      },
      "yt": {
        "title": "YouTube",
        "open": "https://www.youtube.com/results?search_query={q}"
      },
      "gh": {
        "title": "GitHub",
        "open": "https://github.com/search?q={q}"
      },
      "aw": {
        "title": "Arch Wiki",
        "open": "https://wiki.archlinux.org/index.php?search={q}"
      },
      "ap": {
        "title": "Arch packages",
        "open": "https://archlinux.org/packages/?q={q}"
      },
      "maps": {
        "title": "OpenStreetMap",
        "open": "https://www.openstreetmap.org/search?query={q}"
      }
    }
  },
  "permissions": {
    "network": [
      "the bang's site, on Enter, in your browser",
      "duckduckgo.com for a bang that isn't listed, on Enter"
    ]
  }
}
