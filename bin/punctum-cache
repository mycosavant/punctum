#!/usr/bin/env python3
"""Read and write the Punctum's cache files safely.

The shell never opens these files itself. This helper:
  - only knows the files in LIMITS, each with its own size cap;
  - only uses a cache directory that is a real directory, owned by the user,
    and not writable by group or others;
  - reads only a regular, owner-owned, single-link file, opened without
    following symlinks, and at most its cap long;
  - writes through a private 0600 temporary file in that directory, then
    renames it over the old file, refusing to replace anything that is not
    an owner-owned regular file. A .json file is written only if it parses,
    so a bad download never replaces the last good one.

Usage: punctum-cache read <name>    prints the file ("" if it's missing)
       punctum-cache write <name>   replaces the file with stdin
"""

import errno
import fcntl
import json
import os
import secrets
import stat
import sys

LIMITS = {
    "last-query": 4 * 1024,
    "geometry.json": 1024,
    "launches.json": 64 * 1024,
    "pinned-apps.json": 16 * 1024,
    "extension-switches.json": 16 * 1024,
    "wasm-trust.json": 64 * 1024,
    "rates.json": 256 * 1024,   # matches ratesMaxBytes in Punctum.qml
}


class Unsafe(Exception):
    pass


def cache_dir():
    return os.path.join(os.path.expanduser("~"), ".cache", "punctum")


def open_dir(path):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o022:
        os.close(fd)
        raise Unsafe("cache directory is not a private directory owned by you: " + path)
    return fd


def check_file(name, st):
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_nlink != 1:
        raise Unsafe(name + " is not a regular file owned by you")


def read_file(dirfd, name):
    limit = LIMITS[name]
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dirfd)
    except FileNotFoundError:
        return b""
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise Unsafe(name + " is a symlink")
        raise
    try:
        st = os.fstat(fd)
        check_file(name, st)
        if st.st_size > limit:
            raise Unsafe("%s is larger than %d bytes" % (name, limit))
        data = os.read(fd, limit + 1)
    finally:
        os.close(fd)
    if len(data) > limit:
        raise Unsafe("%s is larger than %d bytes" % (name, limit))
    return data


def write_file(dirfd, name, data):
    if len(data) > LIMITS[name]:
        raise Unsafe("refusing to write more than %d bytes to %s" % (LIMITS[name], name))
    if name.endswith(".json"):
        try:
            json.loads(data.decode("utf-8"))
        except (UnicodeDecodeError, ValueError):
            raise Unsafe("refusing to write invalid JSON to " + name)
    try:
        check_file(name, os.stat(name, dir_fd=dirfd, follow_symlinks=False))
    except FileNotFoundError:
        pass

    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(8))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600, dir_fd=dirfd)
    try:
        os.fchmod(fd, 0o600)
        view = memoryview(data)
        while view:
            view = view[os.write(fd, view):]
        os.fsync(fd)
        os.close(fd)
        fd = -1
        os.rename(tmp, name, src_dir_fd=dirfd, dst_dir_fd=dirfd)
        os.fsync(dirfd)
    except BaseException:
        if fd >= 0:
            os.close(fd)
        try:
            os.unlink(tmp, dir_fd=dirfd)
        except OSError:
            pass
        raise


def main(argv):
    if len(argv) != 2 or argv[0] not in ("read", "write") or argv[1] not in LIMITS:
        print("usage: punctum-cache read|write " + "|".join(sorted(LIMITS)), file=sys.stderr)
        return 2
    action, name = argv

    # Read stdin before taking the lock, and never more than one byte past the cap.
    data = sys.stdin.buffer.read(LIMITS[name] + 1) if action == "write" else b""

    dirfd = open_dir(cache_dir())
    try:
        fcntl.flock(dirfd, fcntl.LOCK_EX)
        if action == "read":
            sys.stdout.buffer.write(read_file(dirfd, name))
        else:
            write_file(dirfd, name, data)
    finally:
        os.close(dirfd)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Unsafe as e:
        print("punctum-cache: refusing: %s" % e, file=sys.stderr)
        sys.exit(1)
    except OSError as e:
        print("punctum-cache: %s" % e, file=sys.stderr)
        sys.exit(1)
